# Maintainer: Mark Gantlett <mark@sophialabs.ca>
pkgname=nomos-bin
pkgver=4.15.0
pkgrel=1
pkgdesc="Deterministic engineering substrate and 42-gate AST verification layer between coding agents and Git"
arch=('x86_64' 'aarch64')
url="https://github.com/mgantlett/nomos"
license=('Apache-2.0')
provides=('nomos')
conflicts=('nomos')
options=('!strip' '!debug')
source_x86_64=("nomos-${pkgver}-x86_64.tar.gz::https://github.com/mgantlett/nomos/releases/download/v${pkgver}/nomos_Linux_x86_64.tar.gz")
sha256sums_x86_64=('4b7cca652299654ecd2afed85651b8654de43892f6258ec35f12e1c71622c704')
source_aarch64=("nomos-${pkgver}-aarch64.tar.gz::https://github.com/mgantlett/nomos/releases/download/v${pkgver}/nomos_Linux_arm64.tar.gz")
sha256sums_aarch64=('ba538eff0f26ff8b5236743c851b38a5b52f3446deb76010a0e4955857bca73c')

package() {
  install -Dm755 "${srcdir}/nomos" "${pkgdir}/usr/bin/nomos"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/NOTICE" "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
  install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/CHANGELOG.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
}
