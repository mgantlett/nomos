{
  "anti-phantom-stop-gate": {
    "Stop": [
      {
        "command": "./scripts/stop-guard.sh",
        "timeout": 10,
        "type": "command"
      }
    ],
    "enabled": true
  },
  "post-edit-ast-radar": {
    "PostInvocation": [
      {
        "command": "./scripts/post-edit-radar.sh",
        "timeout": 5,
        "type": "command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "./scripts/post-edit-radar.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "enabled": true
  },
  "prevent-manual-build": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./scripts/nomos-build-guard.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "run_command|Bash|bash|execute_command"
      }
    ],
    "enabled": true
  },
  "session-handshake": {
    "SessionStart": [
      {
        "command": "./scripts/session-start.sh",
        "timeout": 10,
        "type": "command"
      }
    ],
    "enabled": true
  },
  "worktree-boundary-guard": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./scripts/worktree-guard.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file|edit_file|write_file|read_file|apply_patch|Write|Edit|MultiEdit|Read|WebFetch|WebSearch|search_web|mcp_.*|mcp__.*"
      }
    ],
    "enabled": true
  }
}
